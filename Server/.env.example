# HotelPro Server Environment Variables Template
# Copy this file to .env and configure values before starting the server

MONGO_URI=mongodb://127.0.0.1:27017/HotelPro
PORT=8001
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=1d

# Module 2 Payment Gateway Configuration
# Options: 'mock' (default for local development & automated testing) or 'razorpay'
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

